# Axis — переменные для docker-compose.prod.yml. Скопировать в .env рядом с ним.
# Секрет сгенерировать:  openssl rand -hex 32

# ── Обязательное ─────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_32_RANDOM_CHARS

# ── Админ (создаётся при первом старте, если задан пароль) ────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE_ME

# ── Режим и доступ ───────────────────────────────────────────────────────────
DEMO_MODE=false
WEB_PORT=8080
# CORS не нужен при доступе через nginx/туннель/Caddy (всё same-origin).
# Указывать реальный origin только если фронт и API открываются с разных адресов.
ALLOWED_ORIGINS=http://localhost:8080

# ── Свой домен + HTTPS (только для docker-compose.tls.yml) ────────────────────
# Заполнить, когда появится домен с A-записью на IP сервера (см. docs/DEPLOY.md).
# Пока пусто — обычный prod-стек и Cloudflare Tunnel этого не требуют.
DOMAIN=
