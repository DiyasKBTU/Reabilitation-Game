MONGO_URI=mongodb://localhost:27017/rehabgame
JWT_SECRET=change-me-in-production-use-32-random-chars
JWT_EXPIRE_DAYS=30
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5500,http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
VERSION=1.0.0

# Демо-режим для показа инвесторам. true → засев демо-врача/пациента и пациентов с
# готовыми сессиями (идемпотентно) + кнопки быстрого входа на странице логина.
# Учётки: demo_doctor / demo_patient, пароль demo1234.
DEMO_MODE=false

# LLM-explainer (клиническое заключение). По умолчанию ВЫКЛЮЧЕН → шаблон без сети/ключа.
# Включить: LLM_ENABLED=true, выбрать провайдера и указать ключ.
LLM_ENABLED=false
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SEC=15
