# Axis — обратный прокси с автоматическим HTTPS (Let's Encrypt).
# {$DOMAIN} подставляется из .env через docker-compose.tls.yml.
# Caddy сам получает и продлевает сертификат для домена и проксирует весь
# трафик (SPA + /api) на web:80 — тот же nginx, что и без TLS.
#
# Порт 80 на этом сервере занят host-nginx соседнего проекта, поэтому отключаем
# авто-редиректы на :80 — Caddy держит только :443 и выпускает сертификат через
# TLS-ALPN-01. Хочешь письма об истечении сертификата — добавь в блок ниже строку:
#   email you@example.com
{
	auto_https disable_redirects
}

{$DOMAIN} {
	reverse_proxy web:80
}
